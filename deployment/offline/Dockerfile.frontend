# Frontend Dockerfile for Offline Deployment
FROM node:20-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy frontend source
COPY frontend/ .

# Build arguments for offline mode
ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_ENABLE_OFFLINE_MODE=true
ARG VITE_ENABLE_FEDERATED_LEARNING=false

# Set environment variables
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_ENABLE_OFFLINE_MODE=${VITE_ENABLE_OFFLINE_MODE}
ENV VITE_ENABLE_FEDERATED_LEARNING=${VITE_ENABLE_FEDERATED_LEARNING}

# Build the application
RUN npm run build:prod

# Production stage
FROM nginx:alpine

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY deployment/offline/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

