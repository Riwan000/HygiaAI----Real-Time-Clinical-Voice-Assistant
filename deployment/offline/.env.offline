# Offline Deployment Environment Configuration
# Copy this file to .env.offline and update with your values

# Qdrant Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Offline Mode Settings
OFFLINE_MODE=true
ENABLE_LOCAL_MODELS=true

# Local Model Configuration (for offline LLM)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama2:7b

# Data Storage Paths
DATA_DIR=/app/data
LOGS_DIR=/app/logs
CACHE_DIR=/app/.cache

# Encryption (generate a secure key for production)
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/hygiaai.log

# Feature Flags
ENABLE_TRANSCRIPTION=true
ENABLE_ENTITY_EXTRACTION=true
ENABLE_RAG=true
ENABLE_VISUALIZATION=true

# Performance Tuning
MAX_WORKERS=4
WORKER_TIMEOUT=300

# HIPAA Compliance (for offline deployments)
ENABLE_AUDIT_LOGGING=true
ENABLE_ENCRYPTION=true
ENABLE_DEIDENTIFICATION=true

